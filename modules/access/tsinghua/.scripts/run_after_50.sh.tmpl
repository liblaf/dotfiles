#!/bin/bash
# -*- mode: sh; -*-
set -o errexit
set -o nounset
set -o pipefail

systemctl --user --now disable goauthing6.service
systemctl --user --now enable goauthing.service

# ref: <https://thu.services/services/#token>
# rclone config create name type [key value]* [flags]
rclone config create seafile seafile \
  url='https://cloud.tsinghua.edu.cn' \
  user='{{ (rbw "清华大学云盘").data.username }}' \
  auth_token='{{ (rbwFields "清华大学云盘").token.value }}'
rclone config create DATA41 smb \
  host='{{ (rbwFields "DATA41").IP.value }}' \
  user='{{ (rbw "DATA41").data.username }}' \
  pass='{{ (rbw "DATA41").data.password }}'

sudo systemctl --now enable "$(systemd-escape --suffix='automount' --path "$HOME/mnt/DATA41")"
sudo systemctl --now enable "$(systemd-escape --suffix='automount' --path "$HOME/mnt/seafile")"
systemctl --user --now disable rclone-mount@tsinghua.service || true
