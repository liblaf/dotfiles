// ref: <https://zellij.dev/documentation/configuration.html>

explicit_theme_hue "dark"
session_serialization false
show_startup_tips false

keybinds {
  shared_except "locked" {
    bind "Alt t" { NewTab; }
  }
}

terminal {
  font "Maple Mono Normal NF CN"
  terminal_requests "existing_session"
}
