# -*- mode: dockercompose; -*-
# yaml-language-server: $schema=https://raw.githubusercontent.com/compose-spec/compose-go/master/schema/compose-spec.json

name: caddy

services:
  caddy:
    cap_add:
      - NET_ADMIN
    container_name: caddy
    environment:
      CLOUDFLARE_API_TOKEN: '{{ (rbwFields "Cloudflare").CADDY_API_TOKEN.value }}'
    image: caddybuilds/caddy-cloudflare:alpine
    network_mode: host
    pull_policy: weekly
    restart: unless-stopped
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-config:/config
      - caddy-data:/data

volumes:
  caddy-config:
  caddy-data:
