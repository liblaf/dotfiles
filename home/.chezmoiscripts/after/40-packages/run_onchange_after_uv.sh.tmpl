#!/bin/bash
# -*- mode: sh; -*-
set -o errexit
set -o nounset
set -o pipefail

# {{ if .packages.pypi }}

readarray -t packages < <(
  comm -2 -3 \
    <(
      sort << 'EOF'
{{ join "\n" .packages.pypi }}
EOF
    ) \
    <(
      uv tool list |
        awk '!/^-/ { print $1 }' |
        sort
    )
)

for package in "${packages[@]}"; do
  case "$package" in
    copier) uv tool install --with cookiecutter "$package" ;;
    *) uv tool install "$package" ;;
  esac
done

# {{ end }} // if .packages.pypi
