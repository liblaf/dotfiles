#!/bin/bash
# -*- mode: sh; -*-
set -o errexit
set -o nounset
set -o pipefail

# ref: <https://thu.services/services/#token>
# rclone config create name type [key value]* [flags]
rclone config create DATA41 smb \
  host='{{ (rbwFields "DATA41").SERVER.value }}' \
  user='{{ (rbw "DATA41").data.username }}' \
  pass='{{ (rbw "DATA41").data.password }}'

rclone config create GJM-AList webdav \
  url='{{ (index (rbw "GJMs AList").data.uris 0).uri }}/dav/' \
  vendor='other' \
  user='{{ (rbw "GJMs AList").data.username }}' \
  pass='{{ (rbw "GJMs AList").data.password }}'

rclone config create Koofr koofr \
  provider='koofr' \
  endpoint='koofr' \
  user='{{ (rbw "Koofr").data.username }}' \
  password='{{ (rbwFields "Koofr").RCLONE_PASSWORD.value }}'

# ref: <https://microlink.io/user-agents>
rclone config create seafile seafile \
  url='https://cloud.tsinghua.edu.cn' \
  user='{{ (rbw "清华大学云盘").data.username }}' \
  auth_token='{{ (rbwFields "清华大学云盘").token.value }}' \
  override.user_agent='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36'

sudo systemctl --now enable "$(systemd-escape --suffix='automount' --path '/mnt/seafile')"
