#!/bin/bash
# -*- mode: sh; -*-
set -o errexit
set -o nounset
set -o pipefail

if systemd-detect-virt --quiet; then exit; fi

sudo systemctl --now enable netdata.service

# {{ include (joinPath .dirs.external "netdata-kickstart.sh") | sha256sum }}
sudo '{{ .dirs.external }}/netdata-kickstart.sh' \
  --non-interactive --stable-channel --disable-telemetry \
  --claim-token '{{ (rbwFields "Netdata").CLAIM_TOKEN.value }}' \
  --claim-rooms '{{ (rbwFields "Netdata").ROOM_ID.value }}' \
  --claim-only || true
