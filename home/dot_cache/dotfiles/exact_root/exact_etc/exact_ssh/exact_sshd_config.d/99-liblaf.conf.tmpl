# -*- mode: ssh_config; -*-
# ref: <https://man.archlinux.org/man/sshd_config.5>
# ref: <https://wiki.archlinux.org/title/OpenSSH#Server_usage>

# ref: <https://ghostty.org/docs/features/ssh#remote-sshd-configuration>
AcceptEnv COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION
AcceptEnv ZELLIJ
AllowUsers {{ .chezmoi.username }}
AuthenticationMethods publickey
PasswordAuthentication no
PermitRootLogin no
Port 63179
