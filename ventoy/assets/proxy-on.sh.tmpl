#!/bin/bash
# -*- mode: sh; -*-

gsettings set org.gnome.system.proxy.ftp host 127.0.0.1
gsettings set org.gnome.system.proxy.ftp port '{{ .services.mihomo.mixed.port }}'
gsettings set org.gnome.system.proxy.http host 127.0.0.1
gsettings set org.gnome.system.proxy.http port '{{ .services.mihomo.mixed.port }}'
gsettings set org.gnome.system.proxy.https host 127.0.0.1
gsettings set org.gnome.system.proxy.https port '{{ .services.mihomo.mixed.port }}'
gsettings set org.gnome.system.proxy.socks host 127.0.0.1
gsettings set org.gnome.system.proxy.socks port '{{ .services.mihomo.mixed.port }}'
gsettings set org.gnome.system.proxy mode manual

export all_proxy='http://127.0.0.1:{{ .services.mihomo.mixed.port }}/'
export ALL_PROXY="$all_proxy"
export ftp_proxy='http://127.0.0.1:{{ .services.mihomo.mixed.port }}/'
export FTP_PROXY="$ftp_proxy"
export http_proxy='http://127.0.0.1:{{ .services.mihomo.mixed.port }}/'
export HTTP_PROXY="$http_proxy"
export https_proxy='http://127.0.0.1:{{ .services.mihomo.mixed.port }}/'
export HTTPS_PROXY="$https_proxy"
export no_proxy='{{ .no_proxy }}'
export NO_PROXY="$no_proxy"
